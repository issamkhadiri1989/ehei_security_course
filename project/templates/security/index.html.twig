{% extends 'base.html.twig' %}

{% block title %}Hello SecurityController!{% endblock %}

{% block body %}
    <fieldset>
        <legend>Connect:</legend>
        <form method="post" action="{{ url('app.login') }}">
            <div>
                <label for="username" class="form-label">Email :</label>
                <input type="email" name="__email_address" id="username" required class="form-control"/>
            </div>
            <div>
                <label for="password" class="form-label">Password: </label>
                <input type="password" id="password" name="__password" class="form-control"/>
            </div>
            <button type="submit" class="btn btn-primary p-2 mt-2">Sign-in</button>
            You don't have an account, <a href="{{ url('app_register') }}">Register now</a>
        </form>
    </fieldset>
{% endblock %}
